% Primary sources for the measures implemented in this repo.
%
% Every entry here has been checked against the source document, not against a
% secondary description of it.  Where an implementation and a published
% description disagree, the disagreement is recorded in the metric's module
% docstring — see speech_eval/metrics/egemaps.py for the alpha ratio.

% ---------------------------------------------------------------------------
% Spectral tilt / spectral balance
% ---------------------------------------------------------------------------

% THE original definition of the alpha ratio.  Defines it as high over low,
% which is what openSMILE computes and what the GeMAPS paper's prose reverses.
@article{frokjaer1975registration,
  title={Registration of voice quality},
  author={Fr{\o}kjaer-Jensen, B{\o}rge and Prytz, Svend},
  journal={Annual Report of the Institute of Phonetics University of Copenhagen},
  volume={9},
  pages={237--251},
  year={1975}
}

% Origin of the Hammarberg index: strongest energy peak in 0-2 kHz relative to
% the strongest peak in 2-5 kHz.
@article{hammarberg1980perceptual,
  title={Perceptual and acoustic correlates of abnormal voice qualities},
  author={Hammarberg, Britta and Fritzell, Bj{\"o}rn and Gauffin, Jan and
          Sundberg, Johan and Wedin, Lage},
  journal={Acta Oto-Laryngologica},
  volume={90},
  number={1-6},
  pages={441--451},
  year={1980}
}

% The alpha measure against vocal loudness: LTAS slope flattens as loudness
% rises.  Computes alpha from a long-term average spectrum rather than as a mean
% over per-frame values -- the aggregation the vocal-effort literature uses.
@article{sundberg2006effects,
  title={Effects of vocal loudness variation on spectrum balance as reflected by
         the alpha measure of long-term-average spectra of speech},
  author={Sundberg, Johan and Nordenberg, Maria},
  journal={The Journal of the Acoustical Society of America},
  volume={120},
  number={1},
  pages={453--457},
  year={2006}
}

% ---------------------------------------------------------------------------
% Parameter set and toolkit
% ---------------------------------------------------------------------------

% Defines eGeMAPS.  Section 6.1 gives the framing actually used: 20 ms Hamming
% windows 10 ms apart, zero-padded to the next power of two, for the spectral
% descriptors; 60 ms windows for F0, harmonic differences, HNR, jitter and
% shimmer; every LLD smoothed by a symmetric 3-frame moving average.
@article{eyben2016geneva,
  title={The {G}eneva Minimalistic Acoustic Parameter Set ({GeMAPS}) for Voice
         Research and Affective Computing},
  author={Eyben, Florian and Scherer, Klaus R. and Schuller, Bj{\"o}rn W. and
          Sundberg, Johan and Andr{\'e}, Elisabeth and Busso, Carlos and
          Devillers, Laurence Y. and Epps, Julien and Laukka, Petri and
          Narayanan, Shrikanth S. and Truong, Khiet P.},
  journal={IEEE Transactions on Affective Computing},
  volume={7},
  number={2},
  pages={190--202},
  year={2016}
}

@inproceedings{eyben2013recent,
  title={Recent developments in {openSMILE}, the {M}unich open-source multimedia
         feature extractor},
  author={Eyben, Florian and Weninger, Felix and Gross, Florian and
          Schuller, Bj{\"o}rn},
  booktitle={Proceedings of the 21st ACM International Conference on Multimedia},
  pages={835--838},
  year={2013}
}

% ---------------------------------------------------------------------------
% Pitch tracking
% ---------------------------------------------------------------------------

% The method behind Praat's "To Pitch (ac)", and so behind the f0_praat metric:
% autocorrelation of the windowed signal divided by the autocorrelation of the
% window, with a Viterbi path search over candidates weighted by the octave,
% octave-jump and voiced/unvoiced costs the metric exposes.
@article{boersma1993accurate,
  title={Accurate short-term analysis of the fundamental frequency and the
         harmonics-to-noise ratio of a sampled sound},
  author={Boersma, Paul},
  journal={Proceedings of the Institute of Phonetic Sciences,
           University of Amsterdam},
  volume={17},
  pages={97--110},
  year={1993}
}

% The toolkit behind f0_praat and formants_praat, reached through parselmouth.
% Cited as software rather than as a method paper because what the formant metric
% depends on is Praat's *implementation* of Burg LPC ("Sound: To Formant (burg)")
% and of the Viterbi formant tracker ("Formant: Track"), including the default
% costs and the reference frequencies the metric's scaling rule reproduces.
% Pin the version actually used: these are settings, and a settings change is a
% measurement change.
@software{boersma2024praat,
  title={{Praat}: doing phonetics by computer},
  author={Boersma, Paul and Weenink, David},
  note={Reached through the parselmouth binding; record the version used},
  url={https://www.praat.org/},
  year={2024}
}

% Subharmonic summation: the F0 of the eGeMAPS parameter set, hence of the
% f0_opensmile metric.  The spectrum is octave shift-added 15 times with
% compression 0.85; GeMAPS sec. 6.1 pins the rest (60 ms windows, 55-1000 Hz,
% voicing threshold 0.7).
@article{hermes1988measurement,
  title={Measurement of pitch by subharmonic summation},
  author={Hermes, Dik J.},
  journal={The Journal of the Acoustical Society of America},
  volume={83},
  number={1},
  pages={257--264},
  year={1988}
}

% The neural tracker behind f0_swiftf0.  No paper; this is the author's own
% citation block, taken verbatim from the package metadata.
@software{nieradzik2025swiftf0,
  title={{SwiftF0}: Fast and Accurate Fundamental Frequency Detection},
  author={Nieradzik, Lars},
  url={https://github.com/lars76/swift-f0},
  year={2025}
}

% The corpus every published pitch-tracker ranking cited in f0.py is measured
% on: read speech with simultaneous laryngograph, so the reference F0 is
% physiological rather than another algorithm's opinion.  Note the regime it
% does NOT cover -- clean read speech only, no high vocal effort, no
% codec-decoded audio.
@inproceedings{pirker2011pitch,
  title={A pitch tracking corpus with evaluation on multipitch tracking scenario},
  author={Pirker, Gregor and Wohlmayr, Michael and Petrik, Stefan and
          Pernkopf, Franz},
  booktitle={Proceedings of Interspeech},
  pages={1509--1512},
  year={2011}
}

