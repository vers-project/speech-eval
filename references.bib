% The autoregressive backend.  Appendix C defines the English text normaliser
% that compare.py applies to both sides of every WER, and every published
% Whisper WER is measured through it.  Note also the log-mel scaling in
% whisper/audio.py: the max-8 floor is relative, the (x+4)/4 affine is absolute,
% so the model is NOT scale-invariant -- see speech_eval/metrics/asr.py.
@inproceedings{radford2023robust,
  title={Robust Speech Recognition via Large-Scale Weak Supervision},
  author={Radford, Alec and Kim, Jong Wook and Xu, Tao and Brockman, Greg and
          McLeavey, Christine and Sutskever, Ilya},
